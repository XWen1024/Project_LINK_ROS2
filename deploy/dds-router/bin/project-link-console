#!/usr/bin/env bash
set -euo pipefail

workspace="${PROJECT_LINK_UBUNTU_WORKSPACE:-/home/xwen/wheeltec_robot}"
set +u
source /opt/ros/humble/setup.bash
source "$workspace/install/setup.bash"
set -u

export ROS_LOCALHOST_ONLY=0

if [[ "${PROJECT_LINK_ENABLE_EXPERIMENTAL_DDS_ROUTER:-0}" == "1" ]]; then
  export ROS_DOMAIN_ID="${PROJECT_LINK_CONSOLE_DOMAIN_ID:-142}"
  export PROJECT_LINK_TRANSPORT_MODE=dds-router
  systemctl --user start project-link-dds-router-ubuntu.service
else
  # Field-safe MVP fallback: use the already verified native ROS 2 domain.
  # Lifecycle/configuration still use SSH; no Router service is started.
  export ROS_DOMAIN_ID="${PROJECT_LINK_CONSOLE_DOMAIN_ID:-42}"
  export PROJECT_LINK_TRANSPORT_MODE=legacy-dds
fi

source "$workspace/scripts/project_link_dds_profile.sh"

exec ros2 run project_link_console_gui project_link_console "$@"
