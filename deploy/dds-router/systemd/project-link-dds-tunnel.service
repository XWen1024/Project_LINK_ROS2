[Unit]
Description=Project LINK SSH loopback tunnel to Orin DDS Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/project_link/dds-transport.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -o ConnectTimeout=8 -L 127.0.0.1:11666:127.0.0.1:11666 ${PROJECT_LINK_ORIN_SSH_TARGET}
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
