#!/usr/bin/env bash
set -euo pipefail

component="${1:-}"
workspace="${PROJECT_LINK_WORKSPACE:-/home/wte/wheeltec_robot}"
unilidar_ws="${UNILIDAR_WS:-/home/wte/unilidar_sdk/unitree_lidar_ros2}"

source_main() {
  cd "$workspace"
  # project_link_env owns the shared ROS domain and installed overlays.
  set +u
  source "$workspace/scripts/project_link_env.sh"
  set -u
}

source_optional_env() {
  local path="$1"
  if [[ -f "$path" ]]; then
    set +u
    set -a
    # shellcheck disable=SC1090
    source "$path"
    set +a
    set -u
  fi
}

case "$component" in
  console-agent)
    source_main
    exec ros2 run project_link_console_agent console_agent
    ;;
  base)
    source_main
    exec ros2 launch turn_on_wheeltec_robot base_serial.launch.py \
      usart_port_name:="${CHASSIS_DEVICE:-/dev/project_link_chassis}"
    ;;
  lidar)
    # ROS 2 Humble setup files are not nounset-safe: they probe variables such
    # as AMENT_TRACE_SETUP_FILES before defining them. Keep strict mode for the
    # component itself, but temporarily disable nounset while sourcing overlays.
    set +u
    source /opt/ros/humble/setup.bash
    source "$unilidar_ws/install/setup.bash"
    set -u
    export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
    export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
    exec ros2 run unitree_lidar_ros2 unitree_lidar_ros2_node --ros-args \
      -p port:="${UNILIDAR_PORT:-/dev/project_link_lidar}"
    ;;
  front-camera)
    source_main
    exec ros2 run project_link_console_agent front_camera --ros-args \
      -p camera_device:="${FRONT_CAMERA_DEVICE:-/dev/project_link_front_camera}" \
      -p rotation_degrees:="${FRONT_CAMERA_ROTATION_DEGREES:-0}" \
      -p prefer_native_mjpeg:="${FRONT_CAMERA_PREFER_NATIVE_MJPEG:-true}" \
      -p manual_exposure:="${FRONT_CAMERA_MANUAL_EXPOSURE:-true}" \
      -p exposure_time_absolute:="${FRONT_CAMERA_EXPOSURE_ABSOLUTE:-300}" \
      -p camera_gain:="${FRONT_CAMERA_GAIN:-32}"
    ;;
  fall-response)
    source_main
    source_optional_env "${PROJECT_LINK_FALL_ENV:-$HOME/.config/project_link/fall_response.env}"
    if [[ -n "${FALL_PYTHON_SITE:-}" ]]; then
      [[ -d "$FALL_PYTHON_SITE" ]] || {
        echo "Configured FALL_PYTHON_SITE does not exist: $FALL_PYTHON_SITE" >&2
        exit 1
      }
      export PYTHONNOUSERSITE=1
      export PYTHONPATH="$FALL_PYTHON_SITE${PYTHONPATH:+:$PYTHONPATH}"
    fi
    exec ros2 launch project_link_fall_response mobile_fall_response.launch.py
    ;;
  wechatbot)
    source_main
    source_optional_env "${PROJECT_LINK_FALL_ENV:-$HOME/.config/project_link/fall_response.env}"
    exec ros2 run project_link_fall_response wechat_notifier_node --ros-args \
      -p credentials_path:="${WECHATBOT_CREDENTIALS:-$HOME/.config/project_link/wechatbot/credentials.json}" \
      -p binding_path:="${WECHATBOT_BINDING:-$HOME/.local/state/project-link/clawbot/binding.json}" \
      -p ledger_path:="${WECHATBOT_LEDGER:-$HOME/.local/state/project-link/clawbot/notifications.sqlite3}"
    ;;
  robot-description)
    source_main
    exec ros2 launch turn_on_wheeltec_robot robot_mode_description.launch.py \
      lidar_mount_yaw_rad:="${LIDAR_MOUNT_YAW_RAD:-3.14159}"
    ;;
  scan)
    source_main
    exec ros2 launch turn_on_wheeltec_robot unilidar_p2s.launch.py
    ;;
  point-lio-map)
    source_main
    exec ros2 launch turn_on_wheeltec_robot point_lio_unilidar_l1.launch.py \
      enable_slam_toolbox:=true \
      odom_only:="${POINT_LIO_ODOM_ONLY:-true}" \
      point_filter_num:="${POINT_LIO_POINT_FILTER_NUM:-2}" \
      filter_size_surf:="${POINT_LIO_FILTER_SIZE_SURF:-0.15}" \
      filter_size_map:="${POINT_LIO_FILTER_SIZE_MAP:-0.15}" \
      cube_side_length:="${POINT_LIO_CUBE_SIDE_LENGTH:-150.0}" \
      det_range:="${POINT_LIO_DET_RANGE:-40.0}" \
      lidar_mount_yaw_rad:="${LIDAR_MOUNT_YAW_RAD:-3.14159}"
    ;;
  nav2)
    source_main
    if pgrep -f 'c63_keyboard_teleop\..*\.py|rviz_ab_drive.py|ab_drive_server|llm_motion_demo_node' >/dev/null 2>&1; then
      echo "A competing direct-drive or keyboard teleop process is running." >&2
      exit 1
    fi
    "$workspace/deploy/systemd/bin/project-link-wait" topic /map 30
    "$workspace/deploy/systemd/bin/project-link-wait" topic /odom_lio 30
    "$workspace/deploy/systemd/bin/project-link-wait" topic /odom 30
    "$workspace/deploy/systemd/bin/project-link-wait" topic /scan_accumulated 30
    exec ros2 launch wheeltec_nav2 point_lio_navigation.launch.py
    ;;
  rf2o-fallback)
    source_main
    "$workspace/deploy/systemd/bin/project-link-wait" topic /odom 30
    "$workspace/deploy/systemd/bin/project-link-wait" topic /scan 30
    exec ros2 launch turn_on_wheeltec_robot rf2o_slam_toolbox.launch.py
    ;;
  visual-grasp)
    source_main
    exec ros2 launch project_link_visual_grasp visual_grasp.launch.py \
      config:="${VISUAL_GRASP_CONFIG:-$workspace/configs/visual_grasp/visual_grasp.yaml}"
    ;;
  vl53l0x)
    source_main
    exec ros2 launch project_link_vl53l0x vl53l0x_gripper.launch.py \
      config:="${VL53L0X_CONFIG:-$workspace/configs/vl53l0x/vl53l0x_gripper.yaml}"
    ;;
  voice-classic)
    source_main
    source_optional_env "${PROJECT_LINK_VOICE_ENV:-$HOME/.config/project_link/voice_api.env}"
    export PROJECT_LINK_VOICE_PROFILE="${PROJECT_LINK_VOICE_PROFILE:-$HOME/.config/project_link/voice_profile.json}"
    set +u
    source "$workspace/scripts/project_link_voice_io.sh"
    set -u
    voice_params=()
    if [[ -f "${PROJECT_LINK_VOICE_PARAMS:-$HOME/.config/project_link/voice_classic.yaml}" ]]; then
      voice_params+=(params_file:="${PROJECT_LINK_VOICE_PARAMS:-$HOME/.config/project_link/voice_classic.yaml}")
    fi
    exec ros2 launch project_link_voice voice_nav2.launch.py "${voice_params[@]}" \
      enable_motion:="${PROJECT_LINK_VOICE_ENABLE_MOTION:-false}" \
      enable_visual_grasp:="${PROJECT_LINK_VOICE_ENABLE_VISUAL_GRASP:-false}"
    ;;
  voice-qwen)
    source_main
    export PROJECT_LINK_VOICE_PROFILE="${PROJECT_LINK_VOICE_PROFILE:-$HOME/.config/project_link/voice_profile.json}"
    export PROJECT_LINK_QWEN_PARAMS="${PROJECT_LINK_QWEN_PARAMS:-$HOME/.config/project_link/voice_qwen.yaml}"
    set +u
    source "$workspace/scripts/project_link_voice_io.sh"
    set -u
    exec "$workspace/scripts/start_qwen_realtime_voice.sh" \
      "${PROJECT_LINK_QWEN_MODE:-nav2-dry}"
    ;;
  uwb-shadow)
    source_main
    source_optional_env "${PROJECT_LINK_UWB_ENV:-$HOME/.config/project_link/uwb.env}"
    export RMW_IMPLEMENTATION="${PROJECT_LINK_UWB_RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
    : "${PROJECT_LINK_UWB_TAG_ADDRESS:?Set PROJECT_LINK_UWB_TAG_ADDRESS in the private UWB environment file}"
    : "${PROJECT_LINK_UWB_DEVICE:=/dev/uwb-bu04}"
    [[ -e "$PROJECT_LINK_UWB_DEVICE" ]] || {
      echo "BU04 device does not exist: $PROJECT_LINK_UWB_DEVICE" >&2
      exit 1
    }
    uwb_params=()
    if [[ -f "${PROJECT_LINK_UWB_PARAMS:-$HOME/.config/project_link/uwb_navigation.yaml}" ]]; then
      uwb_params+=(params_file:="${PROJECT_LINK_UWB_PARAMS:-$HOME/.config/project_link/uwb_navigation.yaml}")
    fi
    exec ros2 launch project_link_uwb_navigation uwb_navigation.launch.py \
      "${uwb_params[@]}" enable_motion:=false
    ;;
  *)
    echo "Unknown Project LINK component: $component" >&2
    exit 2
    ;;
esac
