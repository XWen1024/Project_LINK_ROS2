# Non-secret systemd runtime overrides for Project LINK.
# Install as ~/.config/project_link/console.env and keep local values out of Git.

PROJECT_LINK_WORKSPACE=/home/wte/wheeltec_robot
UNILIDAR_WS=/home/wte/unilidar_sdk/unitree_lidar_ros2
CHASSIS_DEVICE=/dev/project_link_chassis
UNILIDAR_PORT=/dev/project_link_lidar
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
# Set only when the current router blocks UDP between wired and Wi-Fi clients.
# PROJECT_LINK_ENABLE_SINGLE_INTERFACE_DDS=1
# PROJECT_LINK_DDS_INTERFACE=wlP1p1s0
# PROJECT_LINK_DDS_PEER_IP=192.168.66.160
FRONT_CAMERA_DEVICE=/dev/project_link_front_camera
FRONT_CAMERA_PREVIEW_FPS=24.0
FRONT_CAMERA_ROTATION_DEGREES=0
FRONT_CAMERA_PREFER_NATIVE_MJPEG=true
FRONT_CAMERA_MANUAL_EXPOSURE=true
FRONT_CAMERA_EXPOSURE_ABSOLUTE=300
FRONT_CAMERA_GAIN=32

POINT_LIO_ODOM_ONLY=true
POINT_LIO_POINT_FILTER_NUM=2
POINT_LIO_FILTER_SIZE_SURF=0.15
POINT_LIO_FILTER_SIZE_MAP=0.15
POINT_LIO_CUBE_SIDE_LENGTH=150.0
POINT_LIO_DET_RANGE=40.0

# Voice services default to dry control. Change only after supervised validation.
PROJECT_LINK_VOICE_ENABLE_MOTION=false
PROJECT_LINK_VOICE_ENABLE_VISUAL_GRASP=false

# The detector is isolated from LeRobot so CUDA Torch never replaces the
# validated SO-101 user-site Torch environment in the main process.
VISUAL_GRASP_CUDA_VENV=/home/wte/.local/share/project-link/venvs/fall-cuda
VISUAL_GRASP_CUDA_SITE=/home/wte/.local/share/project-link/venvs/fall-cuda/lib/python3.10/site-packages
PROJECT_LINK_QWEN_MODE=nav2-dry

# Secret values such as API keys and the UWB tag address belong in the module
# files documented in deploy/systemd/README.md, not in this shared file.
