[Unit]
Description=Project LINK Android fall gateway and fail-closed visual/Nav2 coordinator
PartOf=project-link-emergency.target
Wants=project-link-front-camera.service
After=project-link-front-camera.service project-link-wechatbot.service

[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/fall_response.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component fall-response
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait action /fall_detection/respond_to_fall 30
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /fall_detection/status 30
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=project-link-emergency.target
