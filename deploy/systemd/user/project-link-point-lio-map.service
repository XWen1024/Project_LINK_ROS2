[Unit]
Description=Project LINK Point-LIO planar mapping
Requires=project-link-lidar.service project-link-robot-description.service project-link-scan.service
After=project-link-lidar.service project-link-robot-description.service project-link-scan.service
Conflicts=project-link-rf2o-fallback.service
PartOf=project-link-mapping.target

[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component point-lio-map
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /odom_lio 45
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /scan_accumulated 45
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /map 45
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
