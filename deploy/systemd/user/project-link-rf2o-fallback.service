[Unit]
Description=Project LINK rf2o EKF slam_toolbox fallback
Requires=project-link-base.service project-link-lidar.service project-link-robot-description.service project-link-scan.service
After=project-link-base.service project-link-lidar.service project-link-robot-description.service project-link-scan.service
Conflicts=project-link-point-lio-map.service project-link-nav2.service
PartOf=project-link-rf2o-fallback.target

[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component rf2o-fallback
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /odometry/filtered 45
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /map 45
ExecStopPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-zero-velocity
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
