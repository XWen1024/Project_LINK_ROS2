[Unit]
Description=Project LINK robot description and sensor transforms
PartOf=project-link-mapping.target project-link-rf2o-fallback.target

[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component robot-description
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
