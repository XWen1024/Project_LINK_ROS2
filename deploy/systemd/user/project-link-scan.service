[Unit]
Description=Project LINK 2D scan projection and rolling accumulation
Requires=project-link-lidar.service project-link-robot-description.service
After=project-link-lidar.service project-link-robot-description.service
PartOf=project-link-mapping.target project-link-rf2o-fallback.target

[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component scan
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /scan 30
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /scan_accumulated 30
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
