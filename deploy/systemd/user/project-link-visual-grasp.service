[Unit]
Description=Project LINK headless visual grasp server
[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component visual-grasp
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /visual_grasp/status 45
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
