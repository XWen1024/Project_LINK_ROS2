[Unit]
Description=Project LINK gripper VL53L0X range bridge
[Service]
Type=simple
WorkingDirectory=/home/wte/wheeltec_robot
EnvironmentFile=-%h/.config/project_link/console.env
ExecStart=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-component vl53l0x
ExecStartPost=/home/wte/wheeltec_robot/deploy/systemd/bin/project-link-wait topic /visual_grasp/tof_status 30
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
