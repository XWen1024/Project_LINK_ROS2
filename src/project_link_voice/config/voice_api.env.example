# Select the ASR provider. Volcano is the production default; faster_whisper is the manual offline fallback.
export PROJECT_LINK_ASR_PROVIDER=volcano

# New Volcano Speech console authentication (preferred).
export VOLCANO_ASR_API_KEY=
export VOLCANO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
export VOLCANO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# Legacy Volcano Speech console authentication. Use only when VOLCANO_ASR_API_KEY is empty.
export VOLCANO_ASR_APP_ID=
export VOLCANO_ASR_ACCESS_TOKEN=

# Manual local fallback model.
export PROJECT_LINK_WHISPER_MODEL=/home/wte/.cache/project_link/models/faster-whisper-small

# DeepSeek official API. deepseek-v4-flash thinking is disabled by the client.
export DEEPSEEK_API_KEY=

# Volcano TTS credentials remain separate from ASR credentials.
export VOLCANO_APP_ID=
export VOLCANO_ACCESS_TOKEN=
export VOLCANO_RESOURCE_ID=seed-tts-2.0
export VOLCANO_SPEAKER=

# Stable local hardware identities. USB replug may change ttyACM/card/PyAudio indexes.
export PROJECT_LINK_WAKEUP_SERIAL=/dev/serial/by-id/usb-WCH.CN_USB_Single_Serial_0004-if00
export PROJECT_LINK_AUDIO_INPUT_NAME=XFM-DP-V0.0.18
export PROJECT_LINK_AUDIO_INPUT_SOURCE=alsa_input.usb-iflytek_XFM-DP-V0.0.18_6c00144060144991f50-01.mono-fallback
export PROJECT_LINK_AUDIO_OUTPUT_DEVICE=alsa_output.usb-C-Media_Electronics_Inc._USB_Audio_Device-00.analog-stereo
