<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot_vertical">

  <!-- Conservative measured outer envelope, including protruding hardware. -->
  <xacro:property name="base_length" value="0.510"/>
  <xacro:property name="base_width" value="0.410"/>
  <xacro:property name="base_box_height" value="0.745"/>
  <xacro:property name="base_ground_clearance" value="0.0785"/>

  <xacro:property name="lidar_offset_x" value="0.190"/>
  <xacro:property name="lidar_offset_y" value="0.000"/>
  <xacro:property name="lidar_offset_z" value="0.550"/>

  <!-- Mechanical mounting frame fixed to the chassis. The chassis-facing yaw
       is 90 deg clockwise from the previous pi-radian assumption. -->
  <xacro:property name="lidar_mount_rpy" value="0.0 1.5708 1.5707963268"/>

  <!-- Verified Unitree driver-frame correction: roll=pi, yaw=115.234 deg. -->
  <xacro:property name="lidar_driver_rpy" value="3.14159 0.0 2.0112063268"/>

  <!-- Unitree factory IMU origin expressed in the LiDAR frame. Axes are parallel. -->
  <xacro:property name="imu_offset_x" value="-0.007698"/>
  <xacro:property name="imu_offset_y" value="-0.014655"/>
  <xacro:property name="imu_offset_z" value="0.00667"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_box_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_box_height/2}" rpy="0 0 0"/>
      <material name="light_grey"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
  </link>

  <link name="unilidar_link">
    <visual>
      <geometry>
        <cylinder length="0.06" radius="0.04"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>

  <joint name="unilidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="unilidar_link"/>
    <origin
      xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}"
      rpy="${lidar_mount_rpy}"/>
  </joint>

  <!-- Driver-published PointCloud2 frame. This is the single TF authority. -->
  <link name="unilidar_lidar"/>

  <joint name="unilidar_lidar_joint" type="fixed">
    <parent link="unilidar_link"/>
    <child link="unilidar_lidar"/>
    <origin xyz="0 0 0" rpy="${lidar_driver_rpy}"/>
  </joint>

  <!-- Driver-published IMU frame, parallel to the LiDAR axes per Unitree. -->
  <link name="unilidar_imu"/>

  <joint name="unilidar_imu_joint" type="fixed">
    <parent link="unilidar_lidar"/>
    <child link="unilidar_imu"/>
    <origin
      xyz="${imu_offset_x} ${imu_offset_y} ${imu_offset_z}"
      rpy="0 0 0"/>
  </joint>

</robot>
